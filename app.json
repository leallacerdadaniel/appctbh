{
  "expo": {
    "name": "Chez Toi BH",
    "slug": "chez-toi-bh",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": "cheztoibh",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/brand/icon.png",
      "bundleIdentifier": "br.cheztoibh.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E80C20",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "br.cheztoibh.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E80C20",
          "image": "./assets/brand/logo-tile.png",
          "imageWidth": 160
        }
      ],
      "expo-localization",
      "expo-sharing",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
